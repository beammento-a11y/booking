// ===================================================================================
//  MentoBeam – FULL Firestore security rules  (replace the whole Rules tab, then Publish)
//  Console → Firestore Database → Rules.   Run "Rules playground" or just Publish – it validates the syntax.
//
//  WHY: anything in the browser (HTML / JS / inspect) can be edited by a visitor, so the REAL protection is here.
//  A visitor who edits the page with DevTools still cannot: change prices/rates, enable a disabled space,
//  edit/delete other people's bookings, over-book a full slot, read other people's lists, read the error log,
//  or reach any admin data. Only the exact "create a pending booking / cancel my own booking / write one error line"
//  actions are allowed, and every field is validated here on the server.
// ===================================================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------- helpers ----------------
    function signedIn() { return request.auth != null; }
    function adm() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function me() { return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data; }
    function isSuper() { return adm() && me().role == 'super'; }
    // permission keys used by the admin panel: dates, bookings, attendance, reports, content, storage, rentals, errors
    function can(p) { return adm() && (me().role == 'super' || (('perms' in me()) && (p in me().perms) && me().perms[p] == true)); }
    function isStr(v, max) { return v is string && v.size() <= max; }
    function isDate(v) { return v is string && v.matches('^\\d{4}-\\d{2}-\\d{2}$'); }
    function isTime(v) { return v is string && v.matches('^\\d{2}:\\d{2}$'); }

    // ---------------- first-time setup / admins ----------------
    match /meta/setup {
      allow read: if true;
      allow create: if signedIn() && !exists(/databases/$(database)/documents/meta/setup);   // only the very first account
    }
    match /secure/{doc} {                       // master delete password hash – never public
      allow read: if isSuper();
      allow create: if signedIn() && !exists(/databases/$(database)/documents/meta/setup);
    }
    match /admins/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || adm());
      allow list: if adm();
      allow create: if (signedIn() && request.auth.uid == uid && request.resource.data.role == 'super'
                        && !exists(/databases/$(database)/documents/meta/setup)) || isSuper();
      allow update, delete: if isSuper();
    }

    // ---------------- exam: dates & slots ----------------
    match /examDates/{id} {
      allow read: if true;
      allow create, update: if can('dates');
      allow delete: if can('dates') || can('storage');
    }
    match /slots/{id} {
      allow read: if true;
      allow create: if can('dates');
      allow delete: if can('dates') || can('storage');
      allow update: if can('dates') || can('bookings') || (
        // a student booking / cancelling may only move the seat counter by exactly one, never above capacity
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['booked'])
        && ((request.resource.data.booked == resource.data.get('booked', 0) + 1
             && (resource.data.get('capacity', null) == null || request.resource.data.booked <= resource.data.capacity))
            || (request.resource.data.booked == resource.data.get('booked', 0) - 1 && request.resource.data.booked >= 0)));
    }

    // ---------------- exam: student registrations ----------------
    match /bookings/{id} {
      allow get: if true;                        // random id = the student's booking code
      allow list: if can('bookings') || can('attendance') || can('reports') || can('dates') || can('storage');
      allow create: if request.resource.data.keys().hasOnly(['slotId', 'dateId', 'date', 'time', 'endTime', 'examTitle', 'name', 'email', 'phone', 'createdAt', 'attended'])
        && isStr(request.resource.data.name, 100) && request.resource.data.name.size() >= 2
        && isStr(request.resource.data.email, 120) && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && isStr(request.resource.data.phone, 30) && request.resource.data.phone.size() >= 7
        && request.resource.data.attended == null
        && request.resource.data.createdAt is number
        && isStr(request.resource.data.slotId, 60)
        && exists(/databases/$(database)/documents/slots/$(request.resource.data.slotId))
        // the booking must match the real slot (cannot be forged) …
        && request.resource.data.dateId == get(/databases/$(database)/documents/slots/$(request.resource.data.slotId)).data.dateId
        && request.resource.data.date == get(/databases/$(database)/documents/slots/$(request.resource.data.slotId)).data.date
        && request.resource.data.time == get(/databases/$(database)/documents/slots/$(request.resource.data.slotId)).data.time
        // … the exam date must not be closed …
        && get(/databases/$(database)/documents/examDates/$(request.resource.data.dateId)).data.get('closed', false) != true
        // … and the seat counter must go up by one in the same transaction
        && getAfter(/databases/$(database)/documents/slots/$(request.resource.data.slotId)).data.booked
           == get(/databases/$(database)/documents/slots/$(request.resource.data.slotId)).data.get('booked', 0) + 1;
      allow update: if can('bookings') || can('attendance');
      allow delete: if can('bookings') || can('storage') || can('dates')
        || (resource.data.attended == null                    // a student cancelling their own, not yet marked, booking
            && (!exists(/databases/$(database)/documents/slots/$(resource.data.slotId))
                || getAfter(/databases/$(database)/documents/slots/$(resource.data.slotId)).data.booked
                   == get(/databases/$(database)/documents/slots/$(resource.data.slotId)).data.get('booked', 0) - 1));
    }

    // ---------------- rentals ----------------
    match /spaces/{id} {
      allow read: if true;
      allow write: if can('rentals');            // only Rentals admins change rates / availability / photos
    }
    match /rentBookings/{id} {
      allow get: if true;                        // random id = the customer's booking code
      allow list: if can('rentals') || can('storage');
      allow create: if request.resource.data.keys().hasOnly(['spaceId', 'spaceName', 'packageId', 'packageName', 'date', 'startTime', 'endTime', 'hours', 'units', 'guests',
                                                              'layout', 'extras', 'extrasText', 'estimate', 'quoteItems', 'name', 'email', 'phone', 'notes', 'status', 'createdAt'])
        && request.resource.data.status == 'pending'                              // customers cannot self-confirm
        && request.resource.data.spaceId in ['hall', 'lab', 'lounge']
        // a space that the admin disabled cannot be booked, even with an edited page
        && (!exists(/databases/$(database)/documents/spaces/$(request.resource.data.spaceId))
            || get(/databases/$(database)/documents/spaces/$(request.resource.data.spaceId)).data.get('available', true) != false)
        && isStr(request.resource.data.name, 120) && request.resource.data.name.size() >= 2
        && isStr(request.resource.data.email, 120) && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && isStr(request.resource.data.phone, 40) && request.resource.data.phone.size() >= 7
        && isStr(request.resource.data.spaceName, 80) && isStr(request.resource.data.packageId, 40) && isStr(request.resource.data.packageName, 80)
        && isDate(request.resource.data.date)
        && isTime(request.resource.data.startTime) && (request.resource.data.endTime == '' || isTime(request.resource.data.endTime))
        && request.resource.data.hours is number && request.resource.data.hours >= 0 && request.resource.data.hours <= 24
        && request.resource.data.units is number && request.resource.data.units >= 1 && request.resource.data.units <= 100
        && request.resource.data.guests is number && request.resource.data.guests >= 1 && request.resource.data.guests <= 500
        && isStr(request.resource.data.layout, 40) && isStr(request.resource.data.extrasText, 300)
        && request.resource.data.extras is list && request.resource.data.extras.size() <= 12
        && request.resource.data.estimate is number && request.resource.data.estimate >= 0 && request.resource.data.estimate <= 10000000
        && request.resource.data.quoteItems is bool
        && (!('notes' in request.resource.data) || isStr(request.resource.data.notes, 700))
        && request.resource.data.createdAt is number;
      allow update: if can('rentals')
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt'])     // a customer may only cancel
            && request.resource.data.status == 'cancelled' && resource.data.status in ['pending', 'confirmed']);
      allow delete: if can('rentals') || can('storage');
    }

    // ---------------- website content ----------------
    match /gallery/{id} { allow read: if true; allow write: if can('content'); }
    match /settings/site   { allow read: if true; allow write: if can('content') || isSuper(); }   // super also saves the Google Sheet link here
    match /settings/rental { allow read: if true; allow write: if can('rentals'); }
    match /settings/{other} { allow read: if true; allow write: if isSuper(); }

    // ---------------- error log: anyone may ADD a line, only admins can read / delete ----------------
    match /errorLogs/{id} {
      allow create: if request.resource.data.keys().hasOnly(['msg', 'code', 'where', 'page', 'stack', 'ua', 'at', 'read'])
        && isStr(request.resource.data.msg, 300) && isStr(request.resource.data.code, 60) && isStr(request.resource.data.where, 40)
        && isStr(request.resource.data.page, 60) && isStr(request.resource.data.stack, 1200) && isStr(request.resource.data.ua, 160)
        && request.resource.data.at is number && request.resource.data.read == false;
      allow read, update, delete: if can('errors');
    }
  }
}
